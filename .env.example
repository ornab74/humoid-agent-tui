HUMOID_PROVIDER=digitalocean
HUMOID_LANGUAGE=en

# DigitalOcean Gradient AI / serverless inference
DIGITALOCEAN_API_KEY=
DIGITALOCEAN_BASE_URL=https://inference.do-ai.run/v1
DIGITALOCEAN_MODEL=REPLACE_WITH_GLM_5_2_MODEL_ID

# Meta Model API / Muse Spark
META_API_KEY=
META_BASE_URL=REPLACE_WITH_META_MODEL_API_OPENAI_COMPATIBLE_V1_URL
META_MODEL=muse-spark-1.1
META_ENABLE_SEARCH_GROUNDING=false

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2

# llama.cpp server, e.g. llama-server -m model.gguf --port 8080
LLAMACPP_API_KEY=local
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=local-model

# LiteRT-LM exposed through an OpenAI-compatible shim
LITERT_API_KEY=local
LITERT_BASE_URL=http://127.0.0.1:8090/v1
LITERT_MODEL=litert-local

HUMOID_WORKSPACE=./workspace
HUMOID_ALLOW_SHELL=false
HUMOID_SHELL_TIMEOUT_SECONDS=45
HUMOID_MAX_TOOL_ROUNDS=12
HUMOID_MAX_OUTPUT_TOKENS=6000
HUMOID_TEMPERATURE=0.2

# Durable conversation memory. Embedded Weaviate falls back to SQLite.
HUMOID_MEMORY_BACKEND=embedded-weaviate
HUMOID_MEMORY_PACKET_MAX_CHARS=12000
WEAVIATE_EMBEDDED_HTTP_PORT=8079
WEAVIATE_EMBEDDED_GRPC_PORT=50050
HUMOID_MEMORY_DB=./.humoid/memory.sqlite3
WEAVIATE_HTTP_HOST=127.0.0.1
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=127.0.0.1
WEAVIATE_GRPC_PORT=50051
WEAVIATE_SECURE=false
WEAVIATE_COLLECTION=HumoidMemoryV1

# Temporary task-scoped project perspective index.
# auto reuses a healthy Weaviate, can launch a disposable embedded instance,
# and falls back to dependency-free local hashing vectors.
HUMOID_PERSPECTIVE_ENABLED=true
HUMOID_PERSPECTIVE_BACKEND=auto
HUMOID_PERSPECTIVE_CHUNK_CHARS=5600
HUMOID_PERSPECTIVE_CHUNK_OVERLAP=600
HUMOID_PERSPECTIVE_MAX_FILES=4000
HUMOID_PERSPECTIVE_MAX_FILE_BYTES=1000000
HUMOID_PERSPECTIVE_SEARCH_LIMIT=12
HUMOID_PERSPECTIVE_PACKET_MAX_CHARS=14000
HUMOID_PERSPECTIVE_VECTOR_DIMS=384
# Separate ports are used only when a disposable embedded perspective server is needed.
HUMOID_PERSPECTIVE_HTTP_PORT=8089
HUMOID_PERSPECTIVE_GRPC_PORT=50059

# Model-aware tool protocol: auto | openai | gemma4 | tagged-json | humoid-v1
HUMOID_TOOL_PROTOCOL=auto
HUMOID_PARALLEL_TOOL_CALLS=true
HUMOID_TOOL_ARGUMENT_MAX_BYTES=131072

# Gemma 4 native agent mode. auto enables it when model name contains gemma-4/gemma4.
# native forces Gemma 4 control-token parsing; off disables Gemma-specific behavior.
HUMOID_GEMMA4_MODE=auto
# off | low | on. low asks for efficient reasoning while preserving tool-turn thought state.
HUMOID_GEMMA4_THINKING=low
HUMOID_GEMMA4_NATIVE_FALLBACK=true
HUMOID_GEMMA4_STRIP_COMPLETED_THOUGHTS=true
HUMOID_GEMMA_AUTOSTART=false

# Advanced orchestration / TUI
HUMOID_AUTONOMY_MODE=balanced
HUMOID_CONTEXT_LIMIT=20000
# Per-model context windows. Gemma defaults lower to reduce local memory pressure.
HUMOID_GEMMA_CONTEXT_LIMIT=10000
HUMOID_GLM_CONTEXT_LIMIT=20000
HUMOID_SHOW_REASONING=true
